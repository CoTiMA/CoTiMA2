\section{Appendix A: Release Notes}

% Permit page breaks after every Appendix argument row.
\setcounter{LTchunksize}{3}

Functions described in this guide bevor are available via the R package CoTiMA downloaded from CRAN. Additional functions and new arguments are continuously developed and can be installed in the beta version from our GitHub repository (Dormann \& Homberg, 2022). Therefore, after the devtools R package is installed (\code{install.packages("devtools")}), the latest version of the R package CoTiMA can also be installed using the code shown in \emph{Figure }\emph{77}.

\begin{lstlisting}[language=R]

library(devtools)
install_github("CoTiMA/CoTiMA")
library(CoTiMA)
\end{lstlisting}

\noindent \emph{Figure }\emph{77}\emph{.} Installing CoTiMA from GitHub

\section{Appendix B: \newline{}Overview of CoTiMA Functions and their Arguments}

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaBiG} \code{(EPIC-}\textbf{\code{BiG}}\code{-Power)}} & Performs fixed effect analysis, random effect analysis, and analysis of publication bias (Egger's tests, PET-PEESE corrections, z-curve analysis). \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaBiG} \code{(EPIC-}\textbf{\code{BiG}}\code{-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctmaInitFit } & \code{NULL} & CoTiMA fit-object & CoTiMA fit-object created with \code{ctmaInit}. \\
\code{activeDirectory} & \code{NULL} & character string & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE} & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\code{PETPEESEalpha } & \code{.10} & values between 0 and 1 & Probability level (condition) below which to change from PET to PEESE. \\
\code{undoTimeScaling} & \code{TRUE} & \code{FALSE/TRUE} & Uses the time scale used in the Extract-Step (i.e., as defined in the \code{delta\_t}\code{i} objects when \code{TRUE}\code{)}. \\
\code{zcurve} & \code{FALSE} & \code{FALSE/TRUE} & Performs z-curve analysis. Could fail if too few studies (e.g., around 10) are supplied. \\
\code{dT} & \code{NULL} & value > 0 & Performs all analyses for one discrete time interval, too, using the interval assigned to \code{dT}. \\
\bottomrule
\end{longtable}
