\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaEmpCov (E}\textbf{\code{P}}\code{IC-BiG-Power)}} & Changes a full correlation matrix by selecting target variables, recode them, combine them (add), and add rows/columns with NA if focal variables are missing. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaEmpCov (E}\textbf{\code{P}}\code{IC-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{combineVariables} & \code{c()} & list of (vectors of) variable positions & Creates composite variables (i.e., means of one or more variables). Variables that should be combined have to be listed in a vector. Variables that should not be combined have to be listed, too. For example, \code{list(1, c(2, 3), 4, c(5, 6))} combines the 2nd and 3rd as well as the 5th and 6th variables of \code{empcov}\code{i}. and leaves the 1st and 4th variable untouched. Instead of positions, variable names could be used if they were also used in the argument \code{targetVariables}. \\
\code{C}\code{ombineVariablesNames} & \code{c()} & vector variable names for combined variables & not yet operational \\
\code{empcov} & \code{NULL} & symmetric correlations matrix & Correlation matrix reported in a primary study. \\
\code{n}\code{.}\code{latent} & \code{NULL} & value > 0 & The number of (latent) variables. Actually, it is the number of all variables at T0. A distinction between latent and manifest variables is not made here. \\
\code{missingVariables} & \code{c()} & vector of variable positions & Augments \code{empcov}\code{i} and \code{pairwiseN}\code{i} by rows and columns containing NA in order to create matrices of the desired dimension. For example, if the desired matrix should contain correlations of the four variables \emph{x}\textsubscript{\emph{0}}\emph{, y}\textsubscript{\emph{0}}\emph{, x}\textsubscript{\emph{1}}\emph{ and y}\textsubscript{\emph{1}}\emph{,} but a primary study did not measure \emph{y}\textsubscript{\emph{1}}, then the 4th variable is missing and the correlation matrix returned by \code{ctmaEmpCov} will be a 4 \(\times\) 4 \code{empcov}\code{i} and a 4 \(\times\) 4 \code{pairwiseN}\code{i} with NA in the 4th row and in the 4th column, respectively. \\
\code{pairwiseN} & \code{NULL} & symmetric matrix of same dimensions as \code{empcov }containing possible \code{pairwiseN}. & A matrix with sample sizes for each correlation of \code{empcov}\code{i}. \\
\code{recodeVariables} & \code{c()} & vector of variable positions or variable names & Recodes desired variables in \code{empcov}\code{i} (i.e., changes the signs of the correlations). For example, \code{c(1, 4)} changes the signs of the correlations in the 1st and 4th row of \code{empcov}\code{i}. Instead of positions, variable names could be used if \code{dimnames} were assigned to \code{empcov}\code{i}. Note that if numbers are used, they should correspond to the positions in the \code{targetVariables}\code{i}\emph{ }object rather than the rows/columns in the \code{empcov}\code{i} object (i.e., recoding is done after \code{targetVariables}\code{i} were selected from \code{empcov}\code{i}). \\
\code{sampleSize} & \code{NULL} & value > 0 & The sample size. It does not need to be specified if \code{pairwiseN}\code{i} is provided instead. \\
\code{targetVariables} & \code{NULL} & vector of variable positions or \newline{}variable names & Selects desired variables in \code{empcov}\code{i}\emph{ }(i.e., deletes those variables that should not be analyzed). For example, \code{c(1, 2, 4, 5)} deletes the 3rd and 6th row and column in a 6 \(\times\) 6 \code{empcov}\code{i}. Instead of positions, variable names could be used if \code{dimnames }were assigned to \code{empcov}\code{i}. \\
\code{Tpoints} & \code{NULL} & value > 1 & The number of time points. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaEqual (EPI}\textbf{\code{C}}\code{-BiG-Power)}} & Statistically tests if the two or more invariant drift parameters in the CoTiMA fit-object supplied are equal. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaEqual (EPI}\textbf{\code{C}}\code{-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE } & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{coresToUse} & \code{2} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{ctmaInvariantFit} & \code{NULL} & CoTiMA fit-object & CoTiMA fit-object that was returned by \code{ctmaFit}. In most cases this is probably the fit of a model in which two effects were specified with the \code{invariantDrift} argument (e.g., two cross effects). \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaFit (EPI}\textbf{\code{C}}\code{-BiG-Power)}} & Fits a CoTiMA model. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaFit (EPI}\textbf{\code{C}}\code{-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE } & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{allInvModel} & \code{FALSE} & \code{FALSE/TRUE} & Whether or not a model should be tested in which all (!) parameters are assumed to be invariant across primary studies. If set to \code{TRUE}, other specifications (e.g., specified with the \code{equalDrift} argument) will be ignored. An all-invariant model is also used by \code{ctmaPower}. \\
\code{binaries} & \code{NULL} & vector consisting of 0 and 1 & Experimental argument. The vector of 0 (for continuous) and 1 (for dichotomous) defines the scale of manifest variables. May require many (e.g., > 30) time points for valid results. \\
\code{catsToCompare} & \code{NULL} & vector of categories' values that should be compared & This argument is the 2nd out of 3 used to specify contrast among categorical moderators. Compared to an unconstrained moderator model, the effects of the categories of the vector specified are set equal. This will reduce the fit (i.e., increase the \emph{-2ll value}), which can be used for comparing it with the unconstrained model. A significant difference indicates that the categories' effects are not equal. For example, \code{catsToCompare}\code{ }\code{=}\code{ }\code{c(2, 3)} sets the drift effects (see below) for categories 2 and 3 equal. Note that the smallest category selected will become the new comparison category (instead of the lowest of all category numbers) and the output will be labelled accordingly. \\
\code{chains} & \code{NULL} \newline{}(= 2) & value > 0 and < available cores & The \code{chains} argument is passed to \code{ctStanFit} and defines the number of chains to be used for Bayesian estimation. \\
\code{CINT} & 0 & string vector of names of means of continuous time intercepts & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{manifestMeans} (and \code{T0mean}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. Note that this is automatically done if \code{indVarying}\code{ }\code{=}\code{ }\code{"CINT"}\code{ }is specified. \\
\code{cluster} & \code{NULL} & vector of same length as number of primary studies & Vector with cluster variables (e.g., countries), e.g., \code{c(1, 1, 1, 3, 3, 6, 7, 8)}. Has to be set up carefully. Will be included in \code{ctmaPrep} in later developmental stages of the CoTiMA package. \\
\code{coresToUse} & \code{2} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{CoTiMAStanctArgs} & \code{NULL} & list of further fitting parameters & All fitting parameters that are allowed in \code{ctStanFit} can be specified here, too. \\
\code{ctmaInitFit} & \code{NULL} & CoTiMA fit-object & Object to which all single ctsem fits of primary studies has been assigned to (i.e., what has been returned by \code{ctmaInit}). \\
\code{customPar} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE} some starting values usually used by \code{ctS}\code{t}\code{anFit} will be used by CoTiMA specific settings. Not recommended to be used in combination with Bayesian estimation. It was introduced to improve handling of large values used in \code{delta\_t}\code{i}. Setting it to \code{FALSE} and use \code{scaleTime} instead could be a better alternative if estimation problems will nevertheless occur. \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\code{drift} & \code{NULL} \newline{}(= all) & vector (!) of row-wise drift matrix elements & Labels for drift effects that should or should not be included. Have to be either of the type \emph{V1toV2} or 0 for effects to be excluded, which is usually not recommended, e.g., \code{c(}\code{"}\code{V1toV1}\code{"}\code{, }\code{"}\code{V2toV1}\code{"}\code{, 0, }\code{"}\code{V2toV2}\code{"}\code{)}. \\
\code{driftsToCompare} & \code{NULL} & string vector of drift names & This argument is the 3rd out of 3 used to specify contrasts among categorical moderators. The strings in the vector define which drift effects is analyzed for possible differences among categories of the moderator(s).  \\
 & & & For example, \code{driftsToCompare}\code{ }\code{=}\code{ }\code{c(}\code{"}\code{V1toV2}\code{"}\code{) t}ogether with \code{catsToCompare}\code{ }\code{=}\code{ }\code{c(2, 3)} and \code{modsToCompare}\code{ }\code{=}\code{ }\code{2} fits a model in which the effect of category 2 and 3 on the drift parameter \emph{V1toV2} of the second moderator is set equal. \\
\code{equalDrift} & \code{NULL} & vector of 0 or 2 or more drift effects & Labels for drift effects that should be set equal. Have to be of the type \emph{V1toV2}, e.g.,\code{ c(}\code{"}\code{V2toV1}\code{"}\code{, }\code{"}\code{V1toV2}\code{"}\code{)}.  \\
 & & & Constrains all listed effects to be equal (e.g., \code{equalDrift = c(}\code{"}\code{V1toV2", "V2toV1"))}. Note that this is not required for testing the assumption that two effects are equal in the population. Use the \code{invariantDrift} argument and then \code{ctmaEqual} to fit second model. \\
\code{finishsamples} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{finishsamples} argument is passed to \code{ctStanFit}. It specifies the number of samples to draw for final results computation. Larger (e.g., 10.000) values make results more exactly replicable. Larger values are recommended before manuscripts are submitted. Very large values (e.g., 100.000) might be helpful if very small effects (e.g., 0.0002) result from estimation. \\
\code{fit} & \code{TRUE} & \code{FALSE/TRUE} & If set to \code{FALSE} only compiled data frame and ctsem model is returned. Useful for customizing ctsem model. \\
\code{i}\code{nd.mod.names} & \code{NULL} & string vector of names & Vector of names for individual-level moderators used in output. Can only be used with primary studies providing raw data. Individual-level moderators are usually provided as the last columns in raw-data files. This is specified in the corresponding \code{rawData} object by adding the number of individual-level moderators, for example: \\
 & & & {\scriptsize \code{rawData2 <- list(}\newline{}\code{fileName = paste0(activeDirectory,}\newline{}\code{"rawData2.txt"), studyNumbers = 6,}\newline{}\code{missingValues = c(-99),}\newline{}\code{standardize = TRUE, header = TRUE,}\newline{}\code{dec = ".", sep = " ", n.ind.mod = 2)}} \\
 & & & Individual-level moderators can also be added later to an existing fit-object created with \code{ctmaInit}. In the following example, raw data are extracted from such an object and the mean of all time intervals per individual is computed. This mean is then added to a copy of the fit-object and saved. Time-interval length as a study-level or individual-level moderator could indicate that qualitatively different processes are captured by different sets of discrete time points. \\
 & & & {\scriptsize \code{CoTiMAInitFit <- readRDS(}\newline{}\code{paste0(activeDirectory,}\newline{}\code{"CoTiMAInitFit.rds"))}\par \code{ind.mod.List <- list()}\par \code{for (i in 1:length(}\newline{}\code{CoTiMAInitFit\$studyFitList)) \{}\par \code{wide <- CoTiMAInitFit\$}\newline{}\code{studyFitList[[i]]\$empraw}\par \code{dtCols <- grep("dT",}\newline{}\code{colnames(wide))}} \\
 & & & {\scriptsize \code{naPos <- which(wide[, dtCols] <=}\newline{}\code{.001, arr.ind = TRUE)}\par \code{wide[, dtCols][naPos] <- NA}\newline{}\code{\# replace missing values coded as < .001}\par \code{ind.mod.List[[i]] <- data.frame(}\newline{}\code{matrix(NA, ncol = 1,}\newline{}\code{nrow = nrow(wide)))}\par \code{colnames(ind.mod.List[[i]]) <- "TI1"}} \\
 & & & {\scriptsize \code{ind.mod.List[[i]]\$TI1 <-}\newline{}\code{apply(as.matrix(wide[, dtCols]),}\newline{}\code{1, mean, na.rm = TRUE)}\par \code{\}}\par \code{CoTiMAInitFit\_iml <- CoTiMAInitFit}\par \code{CoTiMAInitFit\_iml\$ind.mod.List <-}\newline{}\code{ind.mod.List}\par \code{saveRDS(CoTiMAInitFit\_iml,}\newline{}\code{paste0(activeDirectory,}\newline{}\code{"CoTiMAInitFit\_iml.rds"))}} \\
\code{ind.mod.number} & \code{NULL} & vector of positions of moderators & Which moderator (in the vector of individual level (!) moderators) shall be used (e.g., 2 for a single moderator or 1:3 for 3 moderators simultaneously). Can only be used with primary studies providing raw data. \\
\code{ind.mod.}\code{type} & \code{"}\code{CONT}\code{"} & \code{"}\code{cont}\code{"} or \code{"cat"} & \code{"}\code{cont}\code{"} or \code{"cat"} of the individual level (!) moderators (mixing them in a single model not yet possible). Can only be used with primary studies providing raw data. \\
\code{indVarying} & \code{FALSE} & \code{FALSE/TRUE}\code{/}\newline{}\code{"}\code{CINT}\code{"} & Specifies a restricted random intercept (RI) model, however, without allowing the variance of the intercepts to vary between studies (see argument \code{randomIntercepts}). RI models could be specified using individually varying ct intercepts (\code{indVarying = }\code{"}\code{CINT}\code{"}) or individually varying manifests (\code{indVarying == TRUE}).  \\
 & & & In case \code{n-manifest = n.latent}, both models are algebraically identical. However, numerically, models with individually varying manifests are easier to fit. Note that \emph{random intercept} models are referred to as \emph{fixed effect} models in the econometric literature. Is set to \code{FALSE} if the argument \code{randomIntercepts} is provided. \\
\code{indVaryingT0} & \code{NULL} & \code{FALSE/TRUE} & Deprecated \\
\code{inits} & \code{NULL} & vector of raw inits & Typical use is to provide raw parameter estimates of a previous fit (of an identical model). Could ensure replicability of results and reduces computation time. Raw estimates could be extracted from previous fit stored in, e.g., \code{previousFit}, by \newline{}{\scriptsize \code{inits <- previousFit\$}\newline{}\code{studyFitList\$stanfit\$rawest}} \\
\code{invariantDrift} & \code{NULL} \newline{}(= all) & vector of drift effects or \code{"}\code{none}\code{"} & Labels for drift effects that should be aggregated. Have to be of the type \emph{V1toV2}, e.g., \code{c(}\code{"}\code{V2t}\code{o}\code{V1}\code{"}\code{)}. \\
\code{iter} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{iter} argument is passed to \code{ctStanFit}. It specifies the number of iterations used for Bayesian estimation, half of which will be devoted to warmup. \\
\code{lambda} & \code{NULL} \newline{}(= identity matrix) & \code{n.latent} \(\times\)\newline{}\code{n.manifest} matrix & Matrix with pattern of fixed (= 1) or free (any string) loadings. \\
\code{manifestMeans} & \code{0} & string vector of names of means of manifest variables & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{manifestMeans} (and \code{T0mean}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. Note that this is automatically done if \code{indVarying = TRUE} is specified. When many waves of data exist, it could be possible to separate latent means from manifest means by setting either of them free. \\
\code{manifestVars} & \code{0} & 0 or \code{n.manifest} \(\times\) \code{n.manifest} matrix with values or strings & Lower triangular matrix with error(co-)variances of manifest indicators. Usually, CoTiMA assumes that a single indicator is used per latent. This typically requires assuming error variances to be 0.0 if only few waves are available.  \\
 & & & Alternatively, they can be assigned a particular value, e.g., 1- Cronbach's alpha. In cases where many waves of observation are available, the error variance of single manifest indicators can be estimated, too. This is achieved by assigning labels. \\
\code{mod.names} & \code{NULL} & (vector of) character object(s) & Names used to label moderators in the output. \\
\code{mod.number} & \code{NULL} & vector of positions of moderators & The position(s) of the moderator(s) in the vector of moderator values compiled with \code{ctmaPrep}, which should be used in a moderated CoTiMA, e.g., \code{c(1, 3)}. \\
\code{mod.ty}\code{pe} & \code{"}\code{c}\code{ont}\code{"} & \code{"}\code{con}\code{t}\code{"} or \code{"}\code{cat}\code{"} & Type of moderator(s). Categorical and continuous moderators could not be used in combination, but more than one continuous or more than one categorical moderator is possible. \\
\code{moderatedDrift} & \code{NULL} \newline{}(= all) & vector of drift effects & Labels for drift effects that should be moderated. Have to be of the type \emph{V1toV2}, e.g., \code{c(}\code{"}\code{V2t}\code{o}\code{V1}\code{"}\code{)}. Is only used if moderators are specified. \\
\code{modsToCompare} & \code{NULL} & vector of positions of selected (!) moderators & This argument is the 1st out of 3 used to specify contrast among categorical moderators. The values define the position(s) of the moderator(s) in the vector of moderator values selected with the \code{mod.number} argument (see above). For example, if \code{mod.number = c(1, 4, 6)} was specified before, \code{modsToCompare = 2} specifies that subsequent contrasts will be performed for the moderator at the 4th position of the moderator(s) in the vector of moderator values compiled with \code{ctmaPrep}. \\
\code{nopriors} & \code{TRUE} & \code{FALSE/TRUE} & Deprecated \\
\code{optimize} & \code{TRUE} & \code{FALSE/TRUE} & The \code{optimize} argument is passed to \code{ctStanFit}. If \code{FALSE}, Bayesian estimations is used. The chosen sampler is conditional on the \code{priors} argument. Note that this works differently than the \code{optimi}\code{se} argument of \code{ctStanFit}. \\
\code{primaryStudyList} & \code{NULL} & list of primary studies & A list of primary studies compiled with \code{ctmaPrep} that contains a subset of studies included in \code{ctmaInit}. Useful to exclude studies without the need to use \code{ctmaInit} again. \\
\code{priors} & \code{FALSE} & \code{FALSE/TRUE } & Replaces previously used and now deprecated \code{nopriors} argument. Consequences of \code{TRUE} or \code{FALSE} are conditional on the \code{optimize} argument. \code{optimize =}\code{ }\code{TRUE} \& \code{priors}\code{ }\code{=}\code{ }\code{FALSE} implies maximum likelihood estimation, \code{optimize}\code{ }\code{=}\code{ }\code{TRUE} \& \code{priors}\code{ }\code{=}\code{ }\code{TRUE} implies maximum a posteriori estimation,  \code{optimize = FALSE} \& \code{priors = TRUE} implies Bayesian estimation using NUTS (No U-Turn Sampler). \\
\code{randomIntercepts} & \code{FALSE} & \code{FALSE/TRU}\code{E}\code{/}\newline{}\code{"}\code{MANIFEST}\code{"}\code{ } & Implements an unrestricted random intercepts model where either the intercepts (\code{TRUE}) or the manifest indicator`` (\code{"}\code{MANIFEST}\code{"}) vary within and between primary studies. Sometimes difficult to fit. It requires that all (!) primary studies have 3 or more waves! \\
\code{sameInitialTimes} & \code{FALSE} & \code{FALSE/TRUE} & Useful argument when raw data are used. When set to \code{FALSE} (default), all initial times points with fully missing data are eliminated from raw data frames, which is prevented when set to \code{TRUE}. Could be useful when it is desired to interpret continuous time intercepts as growth factors with the same initial starting point (e.g., school enrolment). \\
\code{scaleClus} & \code{TRUE} & \code{FALSE/TRUE} & The argument \code{scaleC}\code{lus}\code{ }\code{=}\code{ }\code{TRUE} leads to centering of dummy variables representing different clusters. \newline{} \\
 & & & If the argument \code{scaleClus = FALSE} is used, the resulting drift effects are those for the reference cluster. The reference cluster either is a cluster that consists of all cluster values that are unique (see main text for explanation) or the cluster with the largest number.\newline{} \\
 & & & If the argument \code{scaleClus = TRUE} is used, the internally created dummy variables are centered (but not standardized). The resulting drift effects are no longer those for the reference cluster. Rather, they represent the average effect across all studies and all clusters. The effect of the centered cluster dummies now represents the mean difference between studies belonging to a particular cluster and all other studies.  \\
 & & & Since one is usually interested in both the size of a drift effect for a particular cluster, we recommend not centering the dummy variables representing clusters (i.e., the argument \code{scaleClus = FALSE} should be used). \\
\newpage
\code{scaleMod} & \code{TRUE} & \code{FALSE/TRUE} & Whether or not continuous moderators should be standardized or categorical moderators should be centered. Recommended for continuous moderators.\par With categorical moderators, the argument \code{scaleMod = TRUE} leads to centering rather than standardization, which requires some explanation. Categorical moderators are internally transformed into dummy variables. The smallest category value represents the reference category. For instance, if 1 \& 2 are unused, 3 is < 19 yrs old, 4 = 19-60 yrs, 5 = all ages mixed, two dummy variables are created. Dummy 1 is 1 if a primary study included people aged 19-60 only, and Dummy 1 is 0 in all other cases. Dummy 2 is 1 if a primary study included people with ages mixed, and dummy 2 is 0 in all other cases.\par  \\
 & & & If the argument \code{scaleMod = FALSE} is used in combination with categorical moderators, the resulting drift effects are those for the reference category, that is, for studies including people < 19 yrs only. The effect of Dummy 1 the represents the changes that result if a study includes people aged 19-60 rather than < 19 yrs. If this effect is significant, the interpretation is that the effect is significantly different compared to the effect found in studies using people < 19 yrs only. Correspondingly, the effect of Dummy 2 the represents the changes that result if a study includes people with all ages mixed rather than < 19 yrs.\par  \\
\newpage
 & & & If the argument \code{scaleMod = TRUE} is used in combination with categorical moderators, the internally created dummy variables are centered (but not standardized; see the argument \code{transfMod} to circumvent this default behavior and standardize them anyway). The resulting drift effects are no longer those for the reference category. Rather, they represent the average effect across all studies and all moderator categories. The effect of the centered Dummy 1 now represents the mean difference between studies including people aged 19-60 and all other studies. If the effect of Dummy 1 is significant, its interpretation is that this category has a significantly different effect compared to all other categories. It does, however, no longer inform about the sizes of the drift effects resulting for this category.\par  \\
 & & & Since one is usually interested in both the size of a drift effect for a particular category and if it is significantly different, we recommend not centering the dummy variables representing categorical moderators (i.e., the argument \code{scaleMod = FALSE} should be used). See the argument \code{catsToCompare} to analyzed difference between categories anyway. \\
\code{scaleTI} & \code{TRUE} & \code{FALSE/TRUE} & With the move from the omx (OpenMX) version of ctsem to the stanct (stan) version, CoTiMA moved from fitting a multi group model to a model in which the groups are represented by dummy variables. These are internally handled as time independent (TI) predictors, and \code{scaleTI} specifies whether or not these dummy variables should be standardized. Recommended since version 0.5.3.1 and set to TRUE. Note that standardizing dummies for primary studies does not affect estimation of aggregated effects. However, without standardization the study-specific effects (in which meta-analysist are usually not interested in) cannot be interpreted as within-study effects. \\
\code{studyCoding} & \code{"dummy"} & \code{"dummy"/"weighted"} & Specifies the contrast basis for primary-study indicators for both Stan and Julia. Dummy coding estimates the population coefficient for a reference study. Weighted coding estimates a sample-size weighted study average and can reduce dependence on an arbitrary reference, but does not add information or by itself provide hierarchical standard errors. \\
\code{studyVarying} & \code{c("CINT",} \newline{}\code{"DIFFUSION",} \newline{}\code{"T0VAR")} & vector of parameter-matrix families & Selects which parameter families may differ between primary studies. DRIFT remains invariant unless \code{"DRIFT"} is added explicitly. Other supported families include \code{"T0MEANS"}, \code{"MANIFESTMEANS"}, \code{"MANIFESTVAR"}, and \code{"LAMBDA"}. This argument changes the model and is independent of the Stan or Julia backend. \\
\newpage
\code{scaleTime} & \code{NULL} \newline{}(= FALSE) & value > 0 & This argument can facilitate model convergence. It internally changes the time scale assigned to \code{delta\_t}\code{i}. For example, \code{scaleTime = 1/12} could change the time scale from months to years. It is usually recommended to avoid \code{delta\_t}\code{i} larger than 6. \\
\code{transfMod} & \code{NULL } & character vector applying R functions to x & Can be used as a replacement of \code{scaleMod} if more than one moderator is analyzed and standardization is not desired for all moderators. Then, it could take the form \newline{}\code{transfMod = c(}\code{"}\code{scale(x)}\code{"}\code{, }\code{"}\code{x}\code{"}\code{, }\code{"}\code{scale(x)}\code{"}\code{)}. \newline{}Alternatively, users can define their own functions, e.g., \newline{}\code{transfMod=(}\code{"}\code{(x - mean(x))}\code{"}\code{)};\newline{}this function centralizes a single moderator without standardization. Another example is \newline{}\code{transfMod=(}\code{"}\code{scale(x) - min(x)}\code{"}\code{),} \newline{}which standardizes x and then shift values to a scale beginning with 0.0. This yields the (unmoderated) drift effects for the reference group with them smallest moderator value. \\
\code{T0means} & 0 & string vector of names of means of T0 latent variable & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{T0mean} (and \code{manifestMeans}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. Note that this is automatically done if \code{indVarying = TRUE} is specified. \\
\code{T0var} & \code{"}\code{a}\code{u}\code{to}\code{"} & \code{NU}\code{L}\code{L/}\code{"}\code{a}\code{u}\code{to}\code{"}\code{/}\newline{}lower triangular matrix & Could be used to specify the Time 0 covariance matrix by setting certain elements free or fixing them to particular values. Usually not recommended. \\
\code{useSampleFraction} & \code{NULL} & value < 1 & To speed up debugging. Provided as fraction (e.g., 1/10). \\
\code{verbose} & 0 & 0, 1, or 2 & The \code{verbose} argument is passed to \code{ctStanFit}. Higher values print more information during model fit. \\
\code{WEC} & \code{FALSE} & \code{FALSE/TRUE} & Deprecated compatibility argument. \code{WEC=TRUE} is currently translated to \code{studyCoding="weighted"} and \code{studyVarying=c("CINT", "DIFFUSION", "T0VAR")} and produces a warning. Use the new arguments directly. Historical WEC models varied DRIFT as well; to request that model explicitly, add \code{"DRIFT"} to \code{studyVarying} and set the intended \code{invariantDrift} specification. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaFitList (plotting)}} & Informs the plot function that more than a single CoTiMA fit-object should be plotted. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaFitList (plotting)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{...} &  & CoTiMA fit-\newline{}objects separated by commas & Everything provided as argument within () will be put into a list because the plotting function requires list as arguments. For example, \code{ctmaFitList(object1, object2)}. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaGetPub (-)}} & Retrieves publication and citation indices for authors from Google Scholar (for an example, see \code{?ctmaGetPub} and \code{summary(pubList\_8)}), which could be further processed with \code{ctmaPub}. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaGetPub (-)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{authorList} & \code{NULL} & List of vectors with 2 elements & Contains information about authors' names and their Google Scholar https address (or their user ID), e.g.,\par \code{list( c("Wilmar B.; Schaufeli", "https://scholar.}\newline{}\code{google.de/citations?hl=en\&user = w1tHcj4AAAAJ"), c("Maureen; Dollard", "user = J6oH3rgAAAAJ") ) )}.\par Authors' surnames are separated from given names or initials by a semicolon! \\
\code{flush} & \code{FALSE} & \code{FALSE/TRUE} & Argument is handed over to scholar R package. If set to \code{TRUE}, the cache will be cleared, and the data reloaded from Google Scholar. Google Scholar will limit the retrieval of information or even suspend it for a while if the cache is flushed too frequently. \\
\code{yearsToExclude} & \code{NULL} & (vector of) years to exclude & Recommended to leave as \code{NULL}. Years could be excluded later when using \code{ctmaPub}. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaInit (EP}\textbf{\code{I}}\code{C-BiG-Power)}} & Fits a ctsem model to a list of primary studies prepared by \code{ctmaPrep}. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaInit (EP}\textbf{\code{I}}\code{C-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE } & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{activeDirectory} & \code{NULL} & character string & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{chains} & \code{NULL} \newline{}(= 2) & values > 0 & The \code{chains} argument is passed to \code{ctStanFit} and specifies the number of chains to be used for Bayesian estimation. \\
\code{checkSingle}\newline{}\code{StudyResults} & \code{TRUE} & \code{FALSE/TRUE} & If set to \code{TRUE}, displays estimates from single study ctsem models and waits for user input to continue. Useful to check estimates before they are saved. \\
\code{CINT} & 0 & string vector of names of means of continuous time intercepts & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{manifestMeans} (and \code{T0mean}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. Note that this is automatically done if \code{indVarying = }\code{"CINT"} is specified. \\
\code{coresToUse} & \code{2} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{CoTiMAStanctArgs} & \code{NULL} & list of further fitting parameters & All fitting parameters that are allowed in \code{ctStanFit} can be specified here, too. \\
\code{customPar} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE} some starting values usually used by \code{ctS}\code{t}\code{anFit} will be used by CoTiMA specific settings. Not recommended to be used in combination with Bayesian estimation. It was introduced to improve handling of large values used in \code{delta\_t}\code{i}. Setting it to \code{FALSE} and use \code{scaleTime} instead could be a better alternative if estimation problems will nevertheless occur. \\
\code{diff} & \code{NULL} & string vector of names of diffusions & Labels for diffusion effects. Have to be either of the character strings of the type \code{"diff\_eta1"} or \code{"diff\_eta2\_eta1"} (= freely estimated) or values (e.g., 0 for effects to be excluded, which is usually not recommended). \\
\code{d}\code{igits} & \code{4} & value > 0 & Rounding used in output. \\
\code{doPar} & \code{1} & integer value > 0 & Deprecated. \\
\code{d}\code{rift} & \code{NULL} \newline{}(= all) & vector (!) of row-wise drift matrix elements & Labels for drift effects that should or should not be included. Have to be either of the type \emph{V1toV2} or 0 for effects to be excluded, which is usually not recommended, e.g., \code{c(}\code{"}\code{V1toV1}\code{"}\code{, }\code{"}\code{V2toV1}\code{"}\code{, 0, }\code{"}\code{V2toV2}\code{"}\code{)}\code{.} \\
\code{experimental} & \code{FALSE} & \code{FALSE/TRUE} &  \\
\code{finishsamples} & \code{NULL }\newline{}(= 1000) & values > 0 & The \code{finishsamples} argument is passed to \code{ctStanFit}. It defines the number of samples to draw for computation of final results. Larger (e.g., 10.000) values make results more exactly replicable. Larger values are recommended before manuscripts are submitted. Very large values (e.g., 100.000) might be helpful if very small effects (e.g., 0.0002) result from estimation. \\
\code{fit} & \code{TRUE} & \code{FALSE/TRUE} & When set to \code{FALSE}, \code{ctmaInit} does not fit the data to the model and returns the data and the ctsem model only, which could be used to make desired adaptations before using \code{ctStanFit}. \\
\code{indVarying} & \code{FALSE} & \code{FALSE/TRUE} & Specifies a random intercept RI model. Works only if all primary studies have 3 or more waves and no missing values (i.e., variables) exist! Note that contrary to \code{ctmaFit} \code{indVarying}\code{ }\code{=}\code{ }\code{"CINT"} is identical to \code{randomIntercepts}\code{ }\code{=}\code{ }\code{TRUE}, and \code{indVarying}\code{ }\code{=}\code{ }\code{TRUE} is identical to \code{randomIntercepts}\code{ }\code{=}\code{ }\code{"}\code{MANIFEST}\code{"}. \\
\code{indVaryingT0} & \code{TRUE} \newline{} & \code{FALSE/TRUE} & Deprecated. \\
\code{i}\code{ter} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{iter} argument is passed to \code{ctStanFit}. It specifies the number of iterations used for Bayesian estimation, half of which will be devoted to warmup. \\
\code{lambda} & \code{NULL} \newline{}(= identity matrix) & \code{n.latent} \(\times\)\newline{}\code{n.manifest} matrix & Matrix with pattern of fixed (= 1) or free (any string) loadings. \\
\code{loadSingleStudy}\newline{}\code{ModelFit} & \code{c()} & string vector with filename followed by the numbers of studies for which the fit is saved & Load the fit of single study ctsem models, e.g.,\par \code{loadSingleStudyModelFit = c("myModel", 1, 4, 5, 6:100)}.\par This is useful, e.g., if primary studies are added to the pool of primary studies. Only the added studies will be fitted, the previously fitted models are loaded, and all is then stored in the fit-object created with \code{ctmaInit}. \\
\code{manifestMeans} & 0 & string vector of names of means of T0 latent variables & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{manifestMeans} (and \code{T0mean}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. Note that this is automatically done if \code{indVarying = TRUE} is specified. \\
\code{manifestVars} & \code{NULL} & 0 or \code{n.manifest} \(\times\) \code{n.manifest} matrix with values or strings & Lower triangular matrix with error(co-)variances of manifest indicators. Usually, CoTiMA assumes that a single indicator is used per latent. This typically requires assuming error variances to be 0.0.  \\
 & & & Alternatively, they can be assigned a particular value, e.g., 1- Cronbach's alpha. In cases where many waves of observation are available, the error variance of single manifest indicators could be estimated, too. This is achieved by assigning labels. \\
\code{n.latent} & \code{NULL} & value > 0 & Number of latent variables. \\
\code{n.manifest} & 0 \newline{}(= n.latent) & value \(\geq\) \newline{}\code{n.latent} & Number of manifest variables. \\
\code{optimize} & \code{TRUE} & \code{FALSE/TRUE} & The \code{optimize} argument is passed to \code{ctStanFit}. If \code{FALSE}, Bayesian estimations is used. The chosen sampler is conditional on the \code{priors} argument. Note that this works differently than the \code{optimise} argument of \code{ctStanFit}. \\
\code{primaryStudies} & \code{NULL} & list & A list created with \code{ctmaPrep} that contains all information (e.g., \code{empcov}\code{i}, \code{delta\_t}\code{i}, \code{sampleSize}\code{i} etc.) relevant for \code{ctmaInit} and subsequent analyses. \\
\code{priors} & \code{FALSE} & \code{FALSE/TRUE } & Replaces previously used and now deprecated \code{nopriors} argument. Consequences of \code{TRUE} or \code{FALSE} are conditional on the \code{optimize} argument. \code{optimize = TRUE} \& \code{priors = FALSE} implies maximum likelihood estimation, \code{optimize = TRUE} \& \code{priors = TRUE} implies maximum a posteriori estimation,  \code{optimize = FALSE} \& \code{priors = TRUE} implies Bayesian estimation using NUTS (No U-Turn Sampler).. \\
\code{randomIntercepts} & \code{FALSE} & \code{FALSE/TRUE} & Specifies a random intercept RI model. Works only if all primary studies have 3 or more waves without missing values (i.e., variables) exist! Note that contrary to \code{ctmaFit}\code{,} \code{indVarying}\code{ }\code{=}\code{ }\code{"CINT"}\code{ }is identical to \code{randomIntercepts}\code{ }\code{=}\code{ }\code{TRUE}, and \code{indVarying}\code{ }\code{=}\code{ }\code{TRUE} is identical to \code{randomIntercepts}\code{ }\code{=}\code{ }\code{"MANIFEST"}\code{.} The difference between the arguments \code{randomIntercepts} and \code{indVarying} is the internal model setup (as processes vs. intercepts), which should yield identical fit. However, sometimes one of the two models is numerically easier to fit, and the fit with the smaller \emph{-2ll value} should be preferred. \\
\code{saveRawData} & \code{list()} & list & A list with required information to save generated pseudo raw data. Might be useful for methodological research questions. For example:\par \code{list("saveRawData\$studyNumbers = c(1: 20), "saveRawData\$fileName" = "pseudoRaw", "saveRawData\$row.names" = FALSE, "saveRawData\$col.names" = TRUE, "saveRawData\$sep" = " ", }\newline{}\code{"saveRawData\$dec" = ".")} \\
\code{sameInitialTimes} & \code{FALSE} & \code{FALSE/TRUE} & Useful argument when raw data are used. When set to \code{FALSE} (default), all initial times points with fully missing data are eliminated from raw data frames, which is prevented when set to \code{TRUE}. Could be useful when it is desired to interpret continuous time intercepts as growth factors with the same initial starting point (e.g., school enrolment). \\
\code{saveSingleStudy}\newline{}\code{ModelFit} & \code{c()} & vector with filename followed by the numbers of studies for which the fit is saved & Save the fit of single study ctsem models (could save a lot of time afterwards if the fit is loaded, e.g.,\par \code{saveSingleStudyModelFit = c("myModel", 1, 4, 5, 6:100)} \\
\code{scaleTI} & \code{NULL} \newline{}(= \code{TRUE}) & \code{FALSE/TRUE} & Whether or not the to standardize the TI predictors that represent the primary study dummies. \\
\code{scaleTime} & \code{NULL} \newline{}(= \code{FALSE}) & value > 0 & Whether or not the time scale used for \code{delta\_t}\code{i} should be changed. For example, \code{scaleTime = 1/12} could change the time scale from months to years. It is usually recommended to avoid \code{delta\_t}\code{i} larger than 6. \\
\code{silentOverwrite} & \code{FALSE} & \code{FALSE/TRUE} & Whether or not to prompt user preventing undesired overwriting of existing single study fit files (requested via \code{saveSingleStudyModelFit}). \\
\code{T0means} & 0 & string vector of names of means of T0 latent variables & Usually, CoTiMA assumes that standardized variables (correlations) are analyzed, which should result in estimates of \code{T0mean} (and \code{manifestMeans}) to be 0.0. To facilitate convergence, these parameters are set to 0.0 by default. They can be set free by providing names. \\
\code{T0var} & \code{"}\code{auto}\code{"} & 0 or \code{n.manifest} \(\times\) \code{n.manifest} matrix with values or strings & Could be used to specify the Time 0 covariance matrix by setting certain elements free or fixing them to particular values. Usually not recommended. \\
\code{useSV} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE} provided starting values will be used. \\
\code{verbose} & \code{0} & 0, 1, or 2 & The \code{verbose} argument is passed to \code{ctStanFit}. Higher values print more information during model fit. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaLCS (-)}} & Takes a CoTiMA fit-object or CTSEM fit and transforms estimates into those estimates typically reported when fitting (dual) latent change score (LCS) models. The fit-object has to include random intercepts (either randomly varying ct intercepts obtained with \code{indVarying = }\code{"CINT"}\code{ }or with or randomly varying manifest means obtained with \code{indVarying = TRUE}). The function could also be used to transform estimates produced with \code{indVarying = TRUE} into estimates that would be obtained with \code{indVarying = }\code{"CINT"}. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaLCS (-)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{CoTiMAFit} & \code{NULL} & CoTiMA fit-object (or ctsem fit object) & Object to which all CoTiMA fit-object has been assigned to (i.e., what has been returned by \code{ctmaFit}). The ctmaLCS function also takes fit-objects delivered by CTSEM. \\
\code{undoTimeScaling} & \code{TRUE} & \code{FALSE/TRUE}\newline{}or any value & Undoes possible time scaling achieve in \code{ctmaInit} or \code{ctmaFit} by setting the argument \code{scaleTime}. When a number is provided instead of a logical argument, the number is used to multiply the obtained effects (e.g., when time is scaled in days in a study, and \code{scaleTime = 30.5} is used, the returned effect corresponds to 1-month intervals). \\
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE } & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{digits} & 4 & integer value > -1 & Rounding used in output. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaOptimizeFit }\newline{}\code{(EP}\textbf{\code{IC}}\code{-BiG-Power)}} & Repeated initial fitting (i.e., applies \code{ctmaInit}) to a primary study or repeated full fitting (i.e., applies \code{ctmaFit}) several times to capitalize on chance for obtaining a hard-to-find optimal fit. Certain fitting parameters can be specified to randomly vary across fitting attempts. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaOptimizeFit }\newline{}\code{(EP}\textbf{\code{IC}}\code{-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE} & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{activeDirectory} & \code{NULL} & character string & Specifies the directory where required files are found and saved. Should end with \code{"}\code{/}\code{"}. For example, \code{"}\code{/Users/GDC/CoTiMA/}\code{"}. \\
\code{coresToUse} & \code{2} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{CoTiMAStanctArgs} & \code{NULL} & list of further fitting parameters & All fitting parameters that are allowed in \code{ctStanFit} can be specified here, too. \\
\code{ctmaFitFit} & \code{NULL} & CoTiMA fit-object created with \code{ctmaFit} & The CoTiMA Full fit-object of which the fit should be improved. \\
\code{ctmaInitFit} & \code{NULL} & CoTiMA fit-object created with \code{ctmaInit} & The CoTiMA Init fit-object that was used when creating the CoTiMA Full fit-object. \\
\code{customPar} & \code{NULL} & \code{FALSE/TRUE} & If set to \code{TRUE} some starting values usually used by \code{ctS}\code{t}\code{anFit} will be used by CoTiMA specific settings. Not recommended to be used in combination with Bayesian estimation. It was introduced to improve handling of large values used in \code{delta\_t}\code{i}. Setting it to \code{FALSE} and use \code{scaleTime} instead could be a better alternative if estimation problems will nevertheless occur. \\
\code{finishsamples} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{finishsamples} argument is passed to \code{ctStanFit}. It specifies the number of samples to draw for final results computation. Larger (e.g., 10.000) values make results more exactly replicable. Larger values are recommended before manuscripts are submitted. Very large values (e.g., 100.000) might be helpful if very small effects (e.g., 0.0002) result from estimation. \\
\code{i}\code{ter} & 5000 & values > 0 & Number of iterations allowed. \\
\code{primaryStudies} & \code{NULL} & list() & A list created with \code{ctmaPrep} that contains all information (e.g., \code{empcov}\code{i}, \code{delta\_t}\code{i}, \code{sampleSize}\code{i}\emph{ }etc.). Relevant for \code{ctmaInit} only. In a typical workflow, one would create new list with \code{ctmaPrep} that only contains the primary studies that were previously identified to yield improper fits. \\
\code{problemStudy} & \code{NULL} & value > 0 & Number of the study (not the position) in the primaryStudies list that should be re-fitted. \\
\code{randomPar} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE}, it overrides the \code{customPar} argument used to create the CoTiMA Full fit-object. Instead, \code{customPar} varies randomly between \code{TRUE} and \code{FALSE} during the number of fit attempts specified with \code{reFits}. \\
\code{randomScaleTI} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE}, randomly varies randomly between \code{TRUE} and \code{FALSE} for scaling the time independent predictors (TIpreds) representing primary studies. Only relevant if \code{ctmaOptimizeFit} is used to re-fit primary studies (i.e., when poor fit was obtained with \code{ctmaFit}). \\
\code{randomScaleTime} & \code{c(1,1)} & a pair of positive values & From a uniform distribution within the provided lower and upper limits a value (rounded to 2 decimals) is drawn for each refit attempt. \\
\code{reFits} & \code{NULL} & value > 0 & How many reFits should be done. \\
\code{saveModelFits} & \code{FALSE} & \code{FALSE/TRUE} & Saves each fitted model into the activeDirectory using the name \code{"}\code{saveModelFits}\code{i}\code{.rds}\code{"}, with \emph{i} representing the number of the current fit attempt. Could be useful if out-of-range estimates interrupt the \code{refit} attempts. \\
\code{scaleTI} & \code{TRUE} & \code{FALSE/TRUE} & Scales the dummy coded (0, 1) time independent predictors (TIpreds) representing the k -- 1 primary study. May help to achieve improved model convergence and better model fit. \\
\code{shuffleStudyList} & \code{FALSE} & \code{FALSE/TRUE} & Usually, the last primary study in the \code{primaryStudyList} is the reference study, for which no dummy variable exists. Sometimes, changing the reference study makes fitting easier, and the argument \code{shuffleStudyList} randomly shuffles the order of the primary studies (and save the current order in the returned fit file for replication). \\
\code{verbose} & \code{0} & 0, 1, or 2 & The \code{verbose} argument is passed to \code{ctStanFit}. Higher values print more information during model fit. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPlotCtsemMod (-)}} & Auxiliary function to plot moderator effects estimated with the ctsem package using \code{ctStanFit}. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPlotCtsemMod (-)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctStanFitObject} & \code{NULL} & CTSEM \newline{}(ctStanFit) fit-\newline{}object & Fit-object created with \code{ctStanFit}, in which a single moderator (= time independent predictor; TIpred) moderates drift effects. \\
\code{fitSummary} & \code{NULL} & Summary object of CTSEM \newline{}(ctStanFit) fit-\newline{}object & Object containing the summary of the fit-object. Saves time by preventing repeatedly applying the summary function on the fit-object. \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{T}\code{I}\code{pred.pos} & \code{1} & values > 0 & The time-independent predictor (TIpred) that represents the moderator. Could be more than one in case dummy variables made from of categorical moderators (e.g., \code{T}\code{I}\code{pred.pos = c(3,4)}). \\
\code{saveFilePrefix} & \code{"Moderator Plot "} & character string & Prefix used for saving plots. \\
\code{scaleTime} & \code{1} & value > 0 & Factor to increase or decrease the time scale (e.g., 1/12 if estimates were based on yearly intervals and figure should show monthly intervals). \\
\code{mod.sd.to.plot} & \code{-1}\code{:}\code{1} & vector & The standard deviation values of the moderator, for which the drift effects are plotted. The argument is ignored if the moderator is represented by dummy variables made from a categorical variable. \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\code{timeUnit} & \code{"}\code{not specified}\code{"} & character string & Label for the x-axis. \\
\code{timeRange} & \code{NULL} & vector with 3 values: c(xMin, xMax, stepwidth) & The range across which discrete time effects are plotted, e.g., \code{c(10,}\code{ }\code{20, .01)} would plot effects from 10 units of time to 20 using steps of .01. Note that a stepwidth < 1 could be specified to obtain more fine-grained figures. \\
\code{yLimitsFor}\newline{}\code{Effects} & values slightly exceeding min and max empirical effect sizes & vector with 2 values: c(yMin, yMax) & The min and max values for the y-axis. Setting explicit values could be better than relying on the automatically determined range, for example, to ensure identical y-axis across a larger set of plots. \\
\code{mod.type} & \code{"cont"} & \code{"cont"} or \code{"cat"} & The type of moderator. \\
\code{no.mod.cats} & \code{NULL} & value > 0 & Need to be specified if \code{type = "cat"}. The number of categories should usually be equal the number of dummy variables used to represent the categorical moderator + 1. \\
\code{n.x.labels} & \code{NULL} & value > 0 & How many values to be used for indicating time points on the x-axis (0 is automatically added and should not be counted). \\
\code{plot} & \code{TRUE} & \code{FALSE/TRUE} & Plots figures if set to \code{TRUE} (default) otherwise only return moderated drift matrices. \\
\code{plot.xMin} & 0 & value \(\geq\) 0 & Smallest x value (time interval) to plot. \\
\code{plot.xMax} & \code{NULL} & value > 0 & Largest x value (time interval) to plot. \\
\code{plot.yMin} & \code{-1} & value & Smallest y value (cross effect) to plot. \\
\code{plot.yMax} & \code{1} & value & Largest y value (cross effect) to plot. \\
\code{plot..type} & \code{"}\code{l}\code{"} & Any letter that can be used to represent the type of plot in R & Two dots (..) should be used. Points, lines, both etc. \\
\code{plot.lty} & \code{1} & Any letter that can be used to represent the type of lines in R & solid, dotted, dashed etc. lines. \\
\code{plot.col} & \code{"}\code{grey}\code{"} & Any color names or color number that can be used to represent the type of lines in R & Line color. \\
\code{plot.lwd} & \code{1.5} & value > 0 & Line width. \\
\code{dot.plot.type} & \code{"}\code{b}\code{"} & Any letter that can be used to represent the type of plot in R & Sets the type of symbol used to show the moderator values along their trajectories. \\
\code{dot.plot.col} & \code{"}\code{black}\code{"} & Any color names or color number that can be used to represent the type of lines in R & Sets the color of the symbol used to show the moderator values. \\
\code{dot.plot.lwd} & \code{.5} & value > 0 & Sets the size of the symbol used to show the moderator values. \\
\code{dot.plot.lty} & \code{3} & Any letter that can be used to represent the type of lines in R & solid, dotted, dashed etc. lines. \\
\code{dot.plot.pch} & \code{16} & Any integer that can be used to represent the type of lines in R & Sets the shape of the symbol used to show the moderator values. \\
\code{dot.plot.cex} & \code{3} & value > 0 & Magnifier for the symbol used to show the moderator values. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPower (EPIC-BiG-}\textbf{\code{Power}}\code{)}} & Performs analysis of post hoc statistical power and required sample sizes to achieve a desired level of statistical power. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPower (EPIC-BiG-}\textbf{\code{Power}}\code{)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctmaInitFit} & \code{NULL} & CoTiMA fit-object & Object to which all single ctsem fits of primary studies has been assigned to (i.e., what has been returned by \code{ctmaInit}). \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{statisticalPower} & \code{c()} & vector & Vector of requested statistical power values, e.g. c(.95, .80). \\
\code{failSafeN} & \code{NULL} & value > 0 & A sample size used to determine across which time intervals expected effects become not significant. If not specified, the average sample size of primary studies will be used. \\
\code{failSafeP} & \code{NULL} & value between 0 and 1 & A \emph{p}-value used to determine across which time intervals expected effects become not significant. If not specified .01 will be used. \\
\code{timeRange} & \code{c(0, 1.5*maxDelta, 1)} & vector with 3 values & Specifies the time range across which statistical power etc. will be computed. A vector with 3 values: starting point, end point, step width, e.g., \code{c(0, 50, 1)}. When \code{timeRange} is not specified, \code{maxDelta} is determined by taking the largest delta found in the primary studies. \\
\code{useMBESS} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE}, the \code{MBESS} package is used to calculate statistical power (slower). Otherwise, use the internal CoTiMA function (faster). \\
\code{coresToUse} & \code{1} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\code{indVarying} & \code{FALSE} & \code{FALSE/TRUE} & Specifies a random (manifest) intercept model. Works only if all primary studies have 3 or more waves and no missing values (i.e., variables) exist. \\
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE} & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{silentOverwrite} & \code{FALSE} & \code{FALSE/TRUE} & Whether or not to prompt user preventing undesired overwriting of existing fit files (requested via \code{saveAllInvFit} or \code{saveAllInvWOSingFit}). \\
\code{loadAllIn}\code{v}\code{Fit} & \code{c()} & character string & Load the fit of a CoTiMA model with all effects invariant across primary studies, e.g., \code{loadAllInvFit = c("myAllInvariantModel")}\code{.} \\
\code{saveAllIn}\code{v}\code{Fit} & \code{c()} & character string & Save the fit of a CoTiMA model with all effects invariant across primary studies, e.g., \code{saveAllInvFit = c("myAllInvariantModel")}\code{.} \\
\code{loadAllInv}\newline{}\code{WOSingFit} & \code{c()} & character string & not yet operational. \\
\code{saveAllInv}\newline{}\code{WOSingFit} & \code{c()} & character string & not yet operational. \\
\code{skipScaling} & \code{TRUE} & \code{FALSE/TRUE} & If set to \code{FALSE}, combined raw data are standardized again. Although pseudo raw data for each primary study have variance = 1.0, this is not the case if they are combined into the single data set that is used to compute the model with all effects being invariant. This is because variance is computed with denominator \emph{N} - 1. Could be corrected by setting \code{skipScaling}\code{ }\code{=}\code{ }\code{FALSE}, but usually has little practical consequences. \\
\code{useSample}\newline{}\code{Fraction} & \code{NULL} & value between 0 and 100 & Analyze only a fraction of the overall sample. Could help speeding up debugging. Provided as percent (e.g., \code{useSampleFraction = 30} uses 30\% of the overall sample size). \\
\code{optimize} & \code{TRUE} & \code{FALSE/TRUE} & The optimize argument is passed to \code{ctStanFit}. If set to \code{FALSE}, Bayesian estimations is used. The chosen sampler is conditional on the priors argument. Note that this works differently than the \code{optimise} argument of \code{ctStanFit}. \\
\code{nopriors} & \code{TRUE} & \code{FALSE/TRUE} & Deprecated. \\
\code{priors} & \code{FALSE} & \code{FALSE/TRUE} & Replaces previously used and now deprecated \code{nopriors} argument. Consequences of \code{TRUE} or \code{FALSE} are conditional on the \code{optimize} argument. \code{optimize = TRUE} \& \code{priors = FALSE} implies maximum likelihood estimation, \code{optimize = TRUE} \& \code{priors = TRUE} implies maximum a posteriori estimation,  \code{optimize = FALSE} \& \code{priors = TRUE} implies Bayesian estimation using NUTS (No U-Turn Sampler). \\
\code{finishsamples} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{finishsamples }argument is passed to \code{ctStanFit}. It specifies the number of samples to draw for final results computation. Larger (e.g., 10.000) values make results more exactly replicable. Larger values are recommended before manuscripts are submitted. Very large values (e.g., 100.000) might be helpful if very small effects (e.g., 0.0002) result from estimation. \\
\code{iter} & \code{NULL} \newline{}(= 1000) & values > 0 & The \code{iter} argument is passed to \code{ctStanFit}. It specifies the number of iterations used for Bayesian estimation, half of which will be devoted to warmup. \\
\code{chains} & \code{NULL} \newline{}(= 2) & values > 0 & The \code{chains} argument is passed to \code{ctStanFit} and defines the number of chains to be used for Bayesian estimation. \\
\code{verbose} & \code{NULL} & 0, 1, or 2 & The \code{verbose} argument is passed to \code{ctStanFit}. Higher values print more information during model fit. \\
\code{customPar} & \code{FALSE} & \code{FALSE/TRUE} & If set to \code{TRUE} some starting values usually used by \code{ctS}\code{t}\code{anFit} will be used by CoTiMA specific settings. Not recommended to be used in combination with Bayesian estimation. It was introduced to improve handling of large values used in \code{delta\_t}\code{i}. Setting it to \code{FALSE} and use \code{scaleTime} instead could be a better alternative if estimation problems will nevertheless occur. \\
\code{scaleTime} & \code{NULL} &  & This argument can facilitate model convergence. It internally changes the time scale assigned to \code{delta\_t}\code{i}. For example, \code{scaleTime = 1/12} could change the time scale from months to years. It is usually recommended to avoid \code{delta\_t}\code{i} larger than 6. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPub (-)}} & Augments \code{ctmaGetPub}. Returns NEPP (= the number of studies published by the authors of the primary studies supplied \emph{until} the year when the primary study was published), NEPPRecency (like NEPP, but limited to the number of years before the publication as specified with the \code{recency} argument). It also returns the \emph{Meaning of NEPP} and \emph{Meaning of NEPPRecency}, which explain what \code{"}\code{number}\code{"} exactly means (e.g., could be the mean of the sum of each author's publication, or the sum of the maximum publications per year of the authors). \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPub (-)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{getPubObj} & \code{NULL} & Object created with \newline{}\code{ctmaPubGet} & Publication (and citation) information of authors. \\
\code{primaryStudyList} & \code{NULL} & list of primary studies & A list of primary studies compiled with \code{ctmaPrep} that contains a subset of studies included in \code{ctmaInit}. Useful to exclude studies without the need to use \code{ctmaInit} again. \\
\code{yearsToExclude} & \code{0} & (vector of) years to exclude & Years to be excluded from computations. For example, the current year might be excluded because publication information might not be very reliable. Early years (e.g., 1900-1960) might be excluded because they would cause invalid publications (sometimes this happens in Google Scholar). \\
\code{targetYear} & \code{NULL} \newline{}(= publication year) & value > 0 & If left \code{NULL}, all publications before the year of the authors' publication count. \\
\code{recency} & \code{5} & value > 0 & \code{ctmaPub} computes two indices. For the first one (NEPP), all years before \code{targetYear} count. For the second one (NEPPrecency), the years between \code{targetYear} and \code{targetYear} - \code{recency} count. \\
\code{indFUN} & \code{"}\code{sum}\code{"} & any of: \code{"mean"},\code{ "sum"},\code{ "max"},\code{ "min"},\code{ "var"} & Specifies the function used to aggregate an individual author's publication numbers, e.g., \code{"}\code{sum}\code{"} (recommended) computes the sum of an author's publication before \code{targetYear}, and \code{"}\code{var}\code{"} computes the variance of the number of publications for an author's first year of publication to \code{targetYear}. \\
\code{colFUN} & \code{"}\code{mean}\code{"} & any of: \code{"mean"},\code{ "sum"},\code{ "max"},\code{ "min"},\code{ "var"} & Specifies the function used to aggregate a group of authors (collective) publication numbers, e.g., \code{"}\code{mean}\code{"} computes the mean of all authors' publication scores (created with \code{indFUN}, e.g., the sums) before \code{targetYear}, and \code{"}\code{max}\code{"} takes largest of all authors' publication scores (created with \code{indFUN}, e.g., the sums) to \code{targetYear}. \\
\code{addAsMod} & \code{FALSE} & \code{FALSE/TRUE } & Currently disabled. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPrep (E}\textbf{\code{P}}\code{IC-BiG-Power)}} & Combines information of primary studies into a list-object and returns this list. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaPrep (E}\textbf{\code{P}}\code{IC-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{selectedStudies} & \code{NULL} & vector with \newline{}integers & Vector of primary study numbers (numeric values with no leading 0; e.g., \code{"}2\code{"} but not \code{"}02\code{"}). \\
\code{excludedElements} & \code{NULL} & vector with \newline{}integers & Could be used to exclude some predefined objects from the results reported. Note that some predefined objects are strongly defined; they have to be used in a special way because they are actually used in subsequent analyses. Some other objects could be used at the researcher's convenience (information is just collected).\par Strongly predefined objects are \code{delta\_t} (should be of the type \code{c(NA, NA)} in cases when raw data are provided, with the number of NAs corresponding to the number of time intervals), \code{sampleSize} (single number), \code{pairwiseN} (matrix of pairwise N; could be used if correlation matrix is based on pairwise N), \newline{}\code{empcov} (correlation matrix), \code{moderator} (vector of numbers; could be continuous or categorical), \code{alphas} (vector of reliability estimates of the variables of a primary study), \code{startValues} (vector of start values), \code{rawData} (information about file name and structure of raw data), \code{empMeans} (means for variables; usually 0), and \code{empVars }(variances for variables; usually 1.0).\par Weakly predefined objects are \code{studyNumber} (intended as a special number used for the outputs of subsequently fitted CoTiMA models), \code{source} (intended as vector of authors' names and publication year), \code{ageM} value intended for indicating the mean age of participants in a primary study, \code{malePercent} (intended as value indicating the percentage of male participants in a primary study), \code{occupation} (intended as vector of character strings representing the occupations of participants in a primary study), \code{country} (intended as single character string representing the country in which a primary study was conducted), and \code{targetVariables} (intended as vector of character strings representing information about the variables used). \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"}\code{/}\code{"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{addElements} & \code{NULL} & vector of character strings & Could be used to add user-defined objects that are handled as the weakly predefined objects. The major purpose is to collect information a researcher regards as important, e.g., \code{c("Important", "Interesting")}\code{.} \\
\code{digits} & \code{4} & value \(\geq\) 0 & Rounding used in output. \\
\code{moderatorLabels} & \code{NULL} & vector of character strings & Vector of names used to label moderators in the output e.g., \code{c("Mod1", "Control")}\code{.} \\
\code{moderatorValues} & \code{NULL} & list of vectors & List of vector of names (assignments) used to label moderators in the output e.g., \code{list(c("}\code{1}\code{ }\code{=}\code{ }\code{Emotional Exhaustion",}\par \code{"2}\code{ }\code{=}\code{ }\code{Exhaustion"), "continuous")}\code{.} \\
\code{newRawDataDirectory} & \code{NULL} & path to directory & Change paths for all raw data files. The original directory is included in the \code{rawData}\code{i} objects (as part of the file name), which could be replaced by \code{newRawDataDirectory}. \\
\code{summary} & \code{TRUE} & \code{FALSE/TRUE} & Requests summary table and xlsx workbook in return object. Could be set to \code{FALSE}\code{ }to avoid reporting errors. \\
\code{ctmaPrepObject} & \code{NULL} & Object created with \code{ctmaPrep} & Object previously created with \code{ctmaPrep}\code{,} from which studies should be excluded. Only works in combination with the argument \code{exclude}\code{d}\code{Studies}. \\
\code{excludedStudies} & \code{NULL} & vector of integers & Studies to be excluded from a previously created \code{ctmaPrep} object. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaRedHet (EPIC-}\textbf{\code{BiG}}\code{-Power)}} & Computes the reduction in heterogeneity of drift effects after moderators are added. Both input models must use \code{studyCoding="weighted"}, include \code{"DRIFT"} in \code{studyVarying}, and use the same study-varying families. The first model contains no substantive moderator and the second adds the moderator of interest. For example, define \code{families <- c("CINT", "DIFFUSION", "T0VAR", "DRIFT")}, fit both models with \code{studyCoding="weighted"}, \code{studyVarying=families}, and the intended \code{invariantDrift} specification, and then supply them to \code{ctmaRedHet}. Interpreting reduction in heterogeneity of individual continuous-time drift coefficients can be challenging because they operate \emph{in concert}; \code{dt} can request corresponding discrete-time effects. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaRedHet (EPIC-}\textbf{\code{BiG}}\code{-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE} & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{activeDirectory} & \code{NULL} & character string & Specifies the directory where required files are found and saved. Should end with \code{"}\code{/}\code{"}. For example, \code{"}\code{/Users/GDC/CoTiMA/}\code{"}. \\
\code{ctmaFitObject} & \code{NULL} & CoTiMA fit-object & A CoTiMA fit-object created with \code{studyCoding="weighted"} and \code{"DRIFT"} included in \code{studyVarying}. \\
\code{ctmaFitObjectMod} & \code{NULL} & CoTiMA fit-object & A corresponding weighted-coding CoTiMA fit-object with \code{"DRIFT"} in \code{studyVarying} and at least one moderating effect. \\
\code{digits} & \code{4} & value > 0 & Rounding used in output. \\
\code{dt} & \code{NULL} & vector of \newline{}values > 0 & Could be used to request (reduction of) heterogeneity across a set of different time intervals. \\
\code{undoTimeScaling} & \code{TRUE} & \code{FALSE/TRUE}\code{ }or any value & Undoes possible time scaling achieved in \code{ctmaFit} by setting the argument \code{scaleTime}. When a number is provided instead of a logical argument, the number is used to multiply the obtained effects (e.g., when time is scaled in days in a study, and \code{scaleTime}\code{ = 30.5} is used, the returned effect corresponds to 1-month intervals). \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaShapeRawData }\newline{}\code{(E}\textbf{\code{P}}\code{IC-BiG-Power)}} & Transform raw data into the form required by ctsem or CoTiMA. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaShapeRawData }\newline{}\code{(E}\textbf{\code{P}}\code{IC-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{dataFrame} & \code{NULL} & R data frame & An (typically pre-processed) R object containing data. For example, using the \emph{foreign} R-package a SPSS data file can be imported using:\par \code{"}\code{tmpData <- data.frame(read.spss(X.sav"), use.value.labels = FALSE))}\code{"},\par by which time stamps are translated into number of seconds since October 14, 1582 (i.e., the internal SPSS format). The time scale can be change with the argument \code{scaleTime} (see below). \\
\code{id} & \code{NULL} & character string & The identifier (i.e., variable label) of subjects if data are in long format. \\
\code{inputDataFrame}\newline{}\code{Format} & \code{NULL} & \code{"}\code{wide}\code{"} or \code{"}\code{long}\code{"} & Specifies if the \code{dataFrame }object contains data in wide or long format. \\
\code{inputTimeFormat} & \code{"}\code{time}\code{"} & \code{"}\code{time}\code{"} or \code{"}\code{delta}\code{"} & Whether time points (\code{"}\code{time}\code{"}) or time intervals (\code{"}\code{delta}\code{"}) are included in the \code{dataFrame} object. \\
\code{missingValues} & \code{NA} & single value & Value that indicates missing values in the \code{dataFrame} object. \\
\code{n.manifest} & \code{NULL} & single value > 0 & Number of process variables in the \code{dataFrame} object (i.e., excluding possible moderators (for CoTiMA) or time dependent (TDpreds) and time independent (TIpreds; for ctsem) per time point. Possibly 2 for CoTiMA in most instances (i.e., a bivariate model). \\
\code{manifest.per.}\newline{}\code{latent} & \code{NULL} &  & The number of manifest variables per latent factor. In most instances there probably is only 1 manifest per latent, but e.g. \code{c(2,3,1)} also possible for 6 manifest variables loading on 3 latent factors. \\
\code{Tpoints} & \code{NULL} & single value > 0 & Number of time points in the \code{dataFrame} object. \\
\code{allInput}\newline{}\code{VariablesNames} & \code{NULL} & vector of character strings & Vector of all process variable names, time dependent predictor names, time independent predictor names, and names of times/deltas. Only required if the \code{dataFrame} does not have column names. Used to identify the variables that should be selected later. \\
\code{orderInput}\newline{}\code{VariablesNames} & \code{NULL} & \code{"}\code{names}\code{"} or \code{"}\code{time}\code{"} & When \code{"}\code{names}\code{"} is specified, the process variables are expected to be in the order X1, X2, X3, Y1, Y2, X3 etc. When \code{"}\code{time}\code{"} is specified, the expected order is X1, Y1, X2, Y2, etc. For ctsem/CoTiMA, the output file will order them by time. \\
\code{targetInput}\newline{}\code{VariablesNames} & \code{NULL} & vector of character strings & The process variables in the \code{dataFrame} that should be used (in \code{"}\code{names}\code{"}\code{ }or in \code{"}\code{times}\code{"} order as specified with the argument \code{orderInputVariablesNames}). This is used to delete variables from the data frame that are not required. \\
\code{targetInput}\newline{}\code{TDpredNames} & \code{NULL} & vector of character strings & Not important for CoTiMA, but perhaps for fitting ctsem models. The vector of character strings should contain the actual TDpreds labels, e.g., 3, or 6, or 9, ... names if \code{Tpoints}\code{ }\code{=}\code{ }\code{3}. Each of the 3, 6, etc. represents one TDpred. One typically does not have TD predictors in a CoTiMA. \\
\code{targetInp}\newline{}\code{TIpredNames} & \code{NULL} & vector of character strings & Time independent (TI) predictor names in \code{dataFrame}. One typically does not have TI predictors in CoTiMA except it uses raw data, where TIpreds are available for individual cases. (in case data are prepared for CoTiMA, TIpreds could be present as moderator variables, which have to be specified using \code{ctmaPrep}) , In case data are prepared for ctsem, having TIpred is feasible, and the vector of character strings should contain the actual TIpred labels in the \code{dataFrame} object. \\
\code{targetTime}\newline{}\code{VariablesNames} & \code{NULL} & vector of character strings & The labels of the time variables and time variables in \code{dataFrame} that should be used, e.g., \code{c(}\code{"}\code{time2}\code{"}\code{, }\code{"}\code{time4}\code{"}\code{)} or \code{c(}\code{"}\code{dT0}\code{"}\code{, }\code{"}\code{dT1}\code{"}\code{)}. \\
\code{outputData}\newline{}\code{FrameFormat} & \code{"}\code{long}\code{"} & \code{"}\code{long}\code{"} or \code{"}\code{wide}\code{"} & The output format of the returned R object. Should be usually \code{"}\code{wide}\code{"} for CoTiMA and \code{"}\code{long}\code{"} for ctsem. \\
\code{o}\code{utput}\newline{}\code{VariablesNames} & \code{"}\code{Y}\code{"} & vector of character strings & The default value \code{"Y"} will result in variable labels Y1\_T0, Y2\_T0, Y3\_T0 etc. with numbers representing the \code{n.manifest} variables. When, e.g., \code{n.manifest}\code{ }\code{=}\code{ }\code{3} one could also specify, e.g., \code{c("X", "Y", }\code{"}\code{Z}\code{"}\code{)}, which will result in Y\_T0, X\_T0, Z\_T0 etc. \\
\code{o}\code{utput}\newline{}\code{TDpredNames} & \code{NULL} & vector of character strings & Not really important for CoTiMA, but perhaps for fitting ctsem models. The default value \code{"TD"} will result in TDpred labels TD1\_T0, TD2\_T0, TD3\_T0 etc. with numbers representing the number of TDpred. When, e.g., three TD labels per time point are specified with the argument \code{targetInputTDpredNames}, one could also specify, e.g., \code{c("A", "B", }\code{"}\code{C}\code{"}\code{)}, which will result in A\_T0, B\_T0, C\_T0 etc. \\
\code{o}\code{utput}\newline{}\code{TIpredNames} & \code{NULL} & vector of character strings & Not really important for CoTiMA, but perhaps for fitting ctsem models. The default value \code{"TI"} will result in TIpred labels TI1, TI2, TI3 etc. with numbers representing the number of TDpred. \\
\code{o}\code{utputTime}\newline{}\code{VariablesNames} & \code{"}\code{time}\code{"} & character string & Not really important for CoTiMA, but perhaps for fitting ctsem models. The default value \code{"time"} will result in time variables labeled time0, time1, time2 etc. \\
\code{o}\code{utputTimeFormat} & \code{"}\code{time}\code{"} & \code{"}\code{time}\code{"} or \code{"}\code{delta}\code{"} & Whether time is stored in absolute time or deltas (time intervals). Note the CoTiMA requires \code{"}\code{delta}\code{"} (and \code{"}\code{wide}\code{"} format), whereas ctsem requires \code{"}\code{t}\code{ime}\code{"} (and \code{"}\code{long}\code{"}\code{ }format). \\
\code{scaleTime} & \code{1} & any positive value & Scales time in the returned data frame by a scalar that is used to multiply the time variable. Typically used to rescale primary study time to the time scale use in other primary studies. For example, \code{scaleTime}\code{ }\code{=}\code{ }\code{1/(60 x 60 x 24 x 365.25)} rescales time provided in seconds (frequent case when imported from SPSS) into years (60sec x 60min x 24hrs x 365.25 days incl. leap years). \\
\code{minInterval} & \code{0}\code{.0001} & single value > .00001 & Set to smaller values than any possible observed measurement interval, but larger than 0.0001. The value is used for indicating unavailable time interval information (caused by missing values) because NA is technically not possible for time intervals. \\
\code{minTolDelta} & \code{NULL} & single value > 0 & The shortest time interval to be tolerated. Could be useful to eliminate invalid data, e.g., because primary researchers coded time wrongly or participants filled in invalid values to time questions or did not adhere to the research protocol. For example, assuming time is coded in months in a study that was supposed to have approximate 12-month (1-year) intervals, a value of 6 would delete values at a time point that was closer than 6 months to the preceding time point.\par Note that \code{minTolDelta} applies to the time intervals after the \code{scaleTime} argument has applied (i.e., \code{scaleTime} may need adaptation for each primary study, but \code{minTolDelta} does not). \\
\code{maxTolDelta} & \code{NULL} & single value > 0 & The longest time interval to be tolerated. Could be useful to eliminate invalid data, e.g., because primary researchers coded time wrongly or participants filled in invalid values to time questions or did not adhere to the research protocol. For example, assuming time is coded in months in a study that was supposed to sample 6 times within a 6-month (1/2-year) time frame, a value of 6 would delete values at all (!!) time points that were farer away from any other one than 6 months.\par Note that \code{maxTolDelta} applies to the time intervals after the \code{scaleTime} argument has applied (i.e., \code{scaleTime }may need adaptation for each primary study, but \code{maxTolDelta} does not). \\
\code{negTolDelta} & \code{FALSE} & \code{FALSE/TRUE} & When the default setting (\code{FALSE}) is used, cases that have at least one negative delta are excluded (may indicate \emph{unreliable responding}). Use the argument \code{minTolDelta} to delete certain variables only. \\
\code{min.val.n.}\code{V}\code{ars} & \code{1} & any integer value between 0 and number of manifest variables & Specifies the minimum no. of valid variables (i.e., non-NA) that has to be available per participant. Default = 1 (retains cases with only 1 valid variable), 0 would retain cases will all variables missing (not very useful). Retaining participants who provide a single valid variable is technically possible, but these participants contribute to the estimation of the variance/mean of this variable only. Since variance/mean are 1/0 in most CoTiMA applications, this is not very informative but at the cost of additional computational burden. Setting \code{min.val.n.Vars}\code{ }\code{=}\code{ }\code{2} is recommended. \\
\code{min.val.Tpoints} & \code{1} & any integer value between 1 and number of available time points & Minimum no. of valid time points (i.e. time points where \code{min.val.n.Vars} is met). Default = 1 retains participants with full set of valid variables at least at one single time point (which will become T0). Setting \code{min.val.Tpoints}\code{ }\code{=}\code{ }\code{2} or higher values retains participants which provide longitudinal information. Since T0 covariances are usually not too interesting, \code{min.val.Tpoints}\code{ }\code{=}\code{ }\code{2} may be more reasonable than the default = 1. \\
\code{standardization} & \code{"}\code{none}\code{"} & Any of \code{"}\code{none}\code{"}, \code{"}\code{withinTimeA}\code{"}, \code{"}\code{withinTimeB}\code{"}, \code{"}\code{withinColumn}\code{"}, \code{"}\code{withinPerson}\code{"}, or \code{"}\code{overall}\code{"} & Different ways to standardize raw data are possible (\code{"}\code{w}\code{ithinTimeA}\code{"}\code{ }standardizes within time points and deletes cases with missing T0 data. \code{"}\code{w}\code{ithinTimeB}\code{"} standardizes within time points and does not delete cases, and in subsequent ctsem or CoTiMA applications the user is advised to use the argument \code{sameInitialTimes}\code{ }\code{=}\code{ }\code{TRUE}. This argument probably handles raw data in the way primary studies do when computing pairwise correlation matrices. \code{"}\code{withinColumn}\code{"} standardizes variables after arranging them in wide format. Since time points without valid data are eliminated for each case (i.e., values are moved from later to earlier time points), this makes the difference to \code{"}\code{withinTimeA}\code{"} and \code{"}\code{withinTimeB}\code{"}. \code{"}\code{withinPerson}\code{"} standardizes all variables within person. \code{"}\code{overall}\code{"} standardizes all variables across all persons. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaStudyCodingBenchmark (-)}} & Runs matched short Bayesian Stan pilots for dummy and weighted primary-study coding and compares their runtime and NUTS geometry. Both conditions use the same data, model arguments, controls, chains, and seed. This is a computational diagnostic and not a substitute for a sufficiently long Bayesian analysis. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaStudyCodingBenchmark (-)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctmaInitFit} & required & \code{ctmaInit} fit-object & Input object used unchanged in both coding conditions. \\
\code{studyVarying} & \code{c("DIFFUSION",} \newline{}\code{"T0VAR")} & vector of parameter families & Selects the parameter families that receive study effects in both pilots. \\
\code{fitArgs} & \code{list()} & named list & Model-specific \code{ctmaFit} arguments shared by both conditions, for example \code{binaries}, \code{randomIntercepts}, and \code{scaleTime}. Controlled benchmark arguments must not be repeated here. \\
\code{iter} & \code{200} & integer > 1 & Total Stan iterations per chain. Short pilots diagnose computation but do not provide publication-ready posterior inference. \\
\code{warmup} & \code{150} & integer from 0 to \code{iter-1} & Warm-up and NUTS adaptation iterations per chain. \\
\code{chains} & \code{4} & positive integer & Number of matched Stan chains. \\
\code{coresToUse} & \code{min(chains, 4)} & positive integer & Number of chains evaluated concurrently. \\
\code{seed} & \code{20260907} & non-negative integer & Random seed reset before each coding condition. \\
\code{adapt\_delta} & \code{0.80} & value between 0 and 1 & Stan target acceptance probability shared by both conditions. \\
\code{max\_treedepth} & \code{10} & positive integer & Maximum NUTS tree depth shared by both conditions. \\
\code{backendArgs} & \code{list()} & named list & Additional Stan backend controls shared by both conditions. Do not repeat \code{warmup}, \code{adapt\_delta}, or \code{max\_treedepth}. \\
\code{retain\_fits} & \code{FALSE} & \code{FALSE/TRUE} & Whether both potentially large CoTiMA/Stan fit objects are retained in the returned benchmark object. Diagnostics and substantive parameter summaries are retained in either case. \\
\code{verbose} & \code{0} & non-negative integer & Verbosity passed to both calls of \code{ctmaFit}. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaSV (EP}\textbf{\code{I}}\code{C-BiG-Power)}} & Computes new start values and returns an augmented list of primary studies that has \emph{inits} elements containing these start values. This list can then be used for the \code{primaryStudies} argument in subsequent \code{ctmaInit} applications. Starting values are obtained by using lavaan to fit discrete time SEM to the primary studies provided. The discrete time estimates are then transformed into their continuous time counterparts and some specific transformations are applied (required by ctsem) before returned. In case of models with 3 or more waves of data, continuous time effects are computed for each interval and then averaged. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{ctmaSV (EP}\textbf{\code{I}}\code{C-BiG-Power)}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctmaInitFit} & \code{NULL} & CoTiMA fit-object & CoTiMA fit-object created with \code{ctmaInit}. \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{coresToUse} & \code{1} & value > 0 or < 0 & The number of cores (threads) to be used for fitting. If a negative value is provided, the value is subtracted from available cores, else the value sets the number of cores to be used. \\
\code{primaryStudies} & \code{NULL} & CoTiMA fit-object created with \code{ctmaPrep} & In cases in which the CoTiMA fit-object assigned to \code{ctmaInitFit} (possibly old fit files) does not contain the \code{primaryStudies} object created with \code{ctmaPrep} it could be added by assigning it to the \code{primaryStudies} argument. \\
\code{replace}\code{S}\code{V} & \code{TRUE} & \code{FALSE/TRUE} & The computed starting values could either replace exiting starting values in the returned list of primary studies or save them as an additional list element \code{inits}. \\
\bottomrule
\end{longtable}
\normalsize

The plot function, which is described next, works slightly different than other CoTiMA functions. Like all other CoTiMA functions, some arguments could be used as always. However, in addition, it is important to note that several plotting parameters (\code{"}\code{fitAddSpecs}\code{"}) have to be assigned to the CoTiMA fit-object before plotting it, rather than providing plotting parameters as arguments to the plot function (e.g., \code{CoTiMAInitFitObject\$xMax <- 200}). This is because the arguments have different effects conditional on the type of fit-object. The number of plotting parameters that can be changed in this way is still limited; we are working on extensions. Further, user-defined plotting parameters differ for fit-objects created with \code{ctmaBiG} versus \code{ctmaInit} and \code{ctmaFit}). Finally, if problems with plot are encountered, we recommend trying \code{ctmaPlot} instead of \code{plot}.

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{plot/ctmaPlot}} & Generates plots. \\[0.45em]
\endfirsthead
\toprule
Argument & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{plot/ctmaPlot}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{ctmaFitObject} & \code{NULL} & CoTiMA fit object & A CoTiMA fit-object created by \code{ctmaInit}, \code{ctmaFit}, or \code{ctmaBiG}. \\
\code{activeDirectory} & \code{NULL} & path to directory & Specifies the directory where required files are found and saved. Should end with \code{"/"}. For example, \code{"/Users/GDC/CoTiMA/"}. \\
\code{saveFilePrefix} & \code{"}\code{ctmaPlot}\code{"} & vector of character strings & Labels for the generated plot, which might be automatically augmented by further information (e.g., \code{"ctmaplot V1toV1}\code{.}\code{png"}). \\
\code{activateRPB} & \code{FALSE} & \code{FALSE/TRUE } & Messages (warning, finished fitting) could be sent to mobile phone if set to \code{TRUE}. \\
\code{plotCrossEffects} & \code{TRUE} & \code{FALSE/TRUE} & Affects plotting of \code{ctmaInit} or \code{ctmaFit} fit-objects only. Plotting of discrete time cross effects can be suspended. \\
\code{plotAutoEffects} & \code{TRUE} & \code{FALSE/TRUE} & Affects plotting of \code{ctmaInit} or \code{ctmaFit} fit-objects only. Plotting of discrete time auto effects can be suspended. \\
\code{timeUnit} & \code{"timeUnit (not specified)"} & vector of character strings & Affects plotting of \code{ctmaInit} or \code{ctmaFit} fit-objects only. Label used for the x-axis of discrete time plots. \\
\code{timeRange} & \code{c()}\par = 0 to 1.5 times the longest interval used in primary studies & vector with 3 \newline{}values: \newline{}c(xMin, xMax, stepwidth) & Affects plotting of \code{ctmaInit} or \code{ctmaFit} fit-objects only. The range across which discrete time effects are plotted, e.g., \code{c(10,}\code{ }\code{20, .01)} would plot effects from 10 units of time to 20 using steps of .01. Note that a stepwidth < 1 could be specified to obtain more fine-grained figures. \\
\code{yLimits}\par \code{ForEffects} & values slightly exceeding min and max empirical effect sizes & vector with 2 \newline{}values: \newline{}c(yMin, yMax) & Affects plotting of \code{ctmaInit} or \code{ctmaFit} fit-objects only. The min and max values for the y-axis. Setting explicit values could be better than relying on the automatically determined range, for example, to ensure identical y-axis across a larger set of plots. \\
\code{mod.values} & \code{-2}\code{:2} & vector with \newline{}numbers & Affects plotting of \code{ctmaFit} fit-objects only. The moderator values for which plots of continuous moderators should be generated. Corresponds to the standard deviations below and above the mean value if the continuous moderator was standardized with \code{scaleMod}\code{ }\code{=}\code{ }\code{TRUE}. Does not affect plotting of categorical moderators. \\
\code{mod.number} & \code{1} & value > 0 & The number of the moderator effect that is plotted if more than a single moderator is included in the fit-object created with \code{ctmaFit}. Note that \code{mod.number} does not select the dummies used for categorical moderators (all dummy effects are plotted); rather it refers to the 1st, 2nd etc. continuous or categorical moderator of an analysis. \\
\code{aggregateLabel} & \code{""} (= nothing) & character(s) & Affects plotting of \code{ctmaFit} fit-objects only. Symbol to be attached to the discrete time plot of a \code{ctmaFit} fit-object. In the case of \code{ctmaInit} fit-objects, each study is usually identified in the plot with a dot inside which the study number is shown. In the case of a \code{ctmaFit} fit-object with aggregated effects, one could use a symbol, e.g., \code{aggregateLabel}\code{ }\code{=}\code{ }\code{"}\(\Sigma\)\code{"}. \\
\code{xLabels} & \code{NULL} & vector with \newline{}numbers & Affects plotting of \code{ctmaFit} fit-objects only. The numbers indicating the time intervals on the x-axis are usually determined automatically. They could also be directly defined, and the values provided are equally distributed across the time range used to plot the discrete time effects, e.g., \code{c(1, 3, 5, 7, 9)}. \\
\code{undoTimeScaling} & \code{TRUE} & \code{FALSE/TRUE} & Undoes possible time scaling achieve in \code{ctmaInit} or \code{ctmaFit} by setting the argument \code{scaleTime}. \\
\bottomrule
\end{longtable}
\normalsize

In the following tables, named list elements rather than function arguments are shown. These list elements have to be explicitly assigned to fit-objects to change the output of the plot function.

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Named List \newline{}Element & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{fitAddSpecs for }\newline{}\code{ctmaBias}\code{ }\newline{}\code{fit-objects}} &  \\[0.45em]
\endfirsthead
\toprule
Named List \newline{}Element & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{fitAddSpecs for }\newline{}\code{ctmaBias}\code{ }\newline{}\code{fit-objects}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{CoTiMAFit\$xMin} & \code{0} & value \(\geq\) 0 & Internally, the x-axis ranges from 0 to 300 (the values shown in the plot are irrelevant). Setting xMin > 0 creates a plot where the left part is left out. For example, if one wants to leave out the first quarter (i.e. 0 to 300/4 = 0 to 75) you could set \newline{}\code{CoTiMAFit\$xMin <- 75}. If one wants extra space on the right-hand side of the plot, one could lift xMax to values larger than 300, e.g., \code{CoTiMAFit\$xMax <- 400}. \\
\code{CoTiMAFit\$xMa}\code{x} & \code{300} & value \(\geq\) 0 & See above. \\
\bottomrule
\end{longtable}
\normalsize

\small
\begin{longtable}{p{0.18\linewidth} p{0.14\linewidth} p{0.22\linewidth} p{0.38\linewidth}}
\toprule
Named List \newline{}Element & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{fitAddSpecs for }\newline{}\code{ctmaInit \& ctmaFit}\textbf{\code{ }}\newline{}\code{fit-objects}} &  \\[0.45em]
\endfirsthead
\toprule
Named List \newline{}Element & Default & Possible \newline{}Values & Explanation \\
\midrule
\multicolumn{3}{p{0.54\linewidth}}{\normalsize \code{fitAddSpecs for }\newline{}\code{ctmaInit \& ctmaFit}\textbf{\code{ }}\newline{}\code{fit-objects}} & \emph{\ldots{} continued} \\[0.45em]
\endhead
\code{CoTiMAFit\$col} & \code{"}\code{grey}\code{"} \& \code{"}\code{black}\code{"} for \code{ctma}\code{-}\code{Init }\& \code{ctmaFit }fit-objects, respectively. & R-type color code & Defines the color of the curve showing the discrete time affects across time, e.g., \code{CoTiMAFit\$col <- }\code{"}\code{red}\code{"} \\
\code{CoTiMAFit\$lwd} & \code{1.5} \& \code{2.5} for \code{ctma}\code{-}\code{Init }\& \code{ctmaFit} fit-objects, respectively. & value \(\geq\) 0 & Defines the line width of the curve showing the discrete time affects across time, e.g., \code{CoTiMAFit\$lwd <- 4} \\
\code{CoTiMAFit\$lty} & \code{1} \& \code{2} for \code{ctma}\code{-}\code{Init }\& \code{ctmaFit} fit-objects, respectively. & R-type integer value \(\geq\) 0 & Defines the line type of the curve showing the discrete time affects across time, e.g., \code{CoTiMAFit\$lty <- 1}, with, e.g., 1 = solid, 2 = dashed, and 3 = dotted. \\
\code{CoTiMAFit\$xMin} & min of \newline{}\code{time}\newline{}\code{Range} & integer values & Limits the displayed range of the discrete time effects plotted. Should only be used in combination with the \code{xLabels} argument. Overrides other setting if multiple fit-objects are supplied. This is still experimental; it is recommended to set \code{timeRange} instead. \\
\code{CoTiMAFit\$xMax} & max of \newline{}\code{time}\newline{}\code{Range} & integer values & Limits the displayed range of the discrete time effects plotted. Should only be used in combination with the \code{xLabels} argument. Overrides other setting if multiple fit-objects are supplied. This is still experimental; it is recommended to set \code{timeRange} instead. \\
\code{CoTiMA}\newline{}\code{Fit\$dot.type} & \code{"}\code{b}\code{"} & R-type characters & Type of the plot. Use \code{"}\code{p}\code{"} for points, \code{"}\code{l}\code{"} for lines, \code{"}\code{b}\code{"} for both, \code{"}\code{c}\code{"} for the lines part alone of \code{"}\code{b}\code{"} etc. \\
... to be continued &  &  &  \\
